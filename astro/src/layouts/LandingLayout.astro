---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'PITHEAD ROASTWORKS — Engineered espresso. Fuel for the shift.',
} = Astro.props;

const canonicalHref =
  import.meta.env.PROD && Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : null;
---

<!DOCTYPE html>
<html lang="en" class="min-h-dvh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#111111" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
  </head>
  <body
    class="min-h-dvh overflow-x-hidden overflow-y-auto bg-coal font-sans text-offwhite antialiased"
  >
    <slot />
  </body>
</html>
