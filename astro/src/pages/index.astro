---
import LandingLayout from '../layouts/LandingLayout.astro';
---

<LandingLayout
  title="PITHEAD ROASTWORKS — Fuel for the shift"
  description="Marks work. Does not decorate it. Engineered espresso, cacao & chocolate — kiosk menu."
>
  <div
    class="relative flex h-dvh max-h-dvh min-h-0 flex-col overflow-hidden bg-coal"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <img
        src="/images/espresso-pour.jpg"
        alt=""
        class="h-full w-full object-cover opacity-90"
        width="1920"
        height="1280"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-coal/88 via-coal/80 to-coal/92"></div>
    </div>

    <div class="relative z-10 flex min-h-0 flex-1 flex-col">
      <h1 class="sr-only">PITHEAD ROASTWORKS — Fuel for the shift</h1>

      <header
        class="flex shrink-0 items-center gap-3 border-b border-black/25 bg-imperial px-3 py-2 shadow-md md:gap-4 md:px-5 md:py-3"
      >
        <a
          href="/"
          class="shrink-0 rounded-md bg-white p-1.5 shadow-sm ring-1 ring-black/10 md:p-2"
          aria-label="Pithead Roastworks home"
        >
          <img
            src="/images/pithead-logo-stacked.png"
            alt="Pithead Roastworks"
            class="h-9 w-auto md:h-11"
            width="180"
            height="80"
            loading="eager"
          />
        </a>
        <p
          class="hidden min-w-0 max-w-[14rem] text-[10px] font-medium uppercase leading-tight tracking-wide text-offwhite/90 lg:block xl:max-w-xs"
        >
          Marks work. Does not decorate it.
        </p>
      </header>

      <main
        class="flex min-h-0 flex-1 flex-col gap-2 p-2 md:flex-row md:items-start md:gap-3 md:p-3 lg:gap-4 lg:p-4"
      >
        <aside class="flex w-full shrink-0 justify-center md:w-auto md:justify-start">
          <div
            class="w-fit max-w-full space-y-2 rounded-sm border border-coal/20 bg-offwhite p-3 text-coal shadow-lg ring-1 ring-black/5 md:max-w-[20rem] md:p-4"
          >
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-imperial md:text-xs">
                Who we are
              </p>
              <p class="mt-1 text-xs font-normal leading-snug text-coal/90 md:text-sm">
                Espresso, cacao, and real melted chocolate — roasted for daily use. Marks work. Does not
                decorate it.
              </p>
            </div>
            <div class="border-t border-coal/10 pt-2 md:pt-3">
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-imperial md:text-xs">
                Visit
              </p>
              <p class="mt-1 text-xs text-coal/80 md:text-sm">Contact for site address.</p>
            </div>
            <div class="border-t border-coal/10 pt-2 md:pt-3">
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-imperial md:text-xs">
                Contact
              </p>
              <ul class="mt-1 space-y-0.5 text-xs text-coal/85 md:text-sm">
                <li>
                  <a href="/contact.php" class="font-medium text-imperial hover:underline">Contact form</a>
                </li>
                <li>
                  <a
                    href="https://instagram.com/"
                    class="font-medium text-imperial hover:underline"
                    rel="noopener noreferrer">Instagram</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </aside>

        <div
          class="min-h-0 min-w-0 flex-1 overflow-y-auto overflow-x-hidden rounded-sm border border-coal/20 shadow-lg ring-1 ring-black/10"
        >
          <div
            class="flex min-h-full min-w-0 justify-center p-2 md:p-3 lg:min-h-0 lg:h-full lg:items-start lg:p-4"
          >
            <div
              class="w-fit max-w-full rounded-sm border border-coal/15 bg-offwhite p-1.5 shadow-md ring-1 ring-black/5 md:p-2"
            >
              <img
                src="/images/pithead-kiosk-menu.png"
                alt="Pithead Roastworks kiosk menu: coffee, cacao, melted chocolate, classic tea, add-ons, the Pit Mocha, and the Shiver Shake with prices."
                class="block h-auto max-w-full"
                width="863"
                height="954"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </main>

      <p
        class="pointer-events-auto absolute bottom-0.5 right-1 z-20 max-w-[14rem] text-end text-[8px] leading-tight text-offwhite/40 md:bottom-1 md:right-3 md:max-w-none md:text-[9px]"
      >
        Photo by{' '}
        <a
          href="https://unsplash.com/@omikron?utm_source=pithead&utm_medium=referral"
          class="underline decoration-offwhite/25 hover:text-offwhite/55"
          rel="noopener noreferrer">Valentin</a
        >
        {' '}on{' '}
        <a
          href="https://unsplash.com/photos/J2cfNw4E0yc?utm_source=pithead&utm_medium=referral"
          class="underline decoration-offwhite/25 hover:text-offwhite/55"
          rel="noopener noreferrer">Unsplash</a
        >
      </p>
    </div>
  </div>
</LandingLayout>
