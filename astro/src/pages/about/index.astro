---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About — PITHEAD ROASTWORKS">
  <section class="border-b border-offwhite/10 py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-4 md:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.35em] text-stone">About</p>
      <h1 class="mt-4 text-4xl font-bold uppercase tracking-tight text-offwhite md:text-5xl">Engineered, not decorated</h1>
      <div class="mt-10 space-y-6 text-lg font-medium text-offwhite/80">
        <p>Fuel for the shift.</p>
        <p>We build coffee and cacao as functional drinks — high torque, milk-forward, zero lifestyle padding.</p>
        <p class="text-offwhite">Marks work. Does not decorate it.</p>
      </div>
    </div>
  </section>
</BaseLayout>
