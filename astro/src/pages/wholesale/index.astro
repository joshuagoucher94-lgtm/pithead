---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Wholesale — PITHEAD ROASTWORKS" description="Fuel your customers. High-performance coffee for cafés.">
  <section class="border-b border-offwhite/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h1 class="text-4xl font-bold uppercase tracking-tight text-offwhite md:text-6xl">Fuel your customers</h1>
      <p class="mt-8 max-w-2xl text-xl font-medium text-offwhite/80">
        We supply cafés with high-performance coffee designed to cut through milk and deliver consistent results.
      </p>
    </div>
  </section>
  <section class="border-b border-offwhite/10 py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 md:grid-cols-3 md:px-8">
      <div>
        <h2 class="text-lg font-bold uppercase tracking-tight text-imperial">Why Pithead</h2>
        <p class="mt-4 text-sm font-medium text-offwhite/75">
          Blends built for extraction discipline and milk performance — not shelf stories.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-bold uppercase tracking-tight text-imperial">Product range</h2>
        <p class="mt-4 text-sm font-medium text-offwhite/75">
          Espresso-led line-up with clear SKU structure. Scales from single-site to multi-site.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-bold uppercase tracking-tight text-imperial">Support</h2>
        <p class="mt-4 text-sm font-medium text-offwhite/75">
          Training and setup kept practical — fewer rituals, more repeatability.
        </p>
      </div>
    </div>
  </section>
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-2xl px-4 md:px-8">
      <h2 class="text-2xl font-bold uppercase tracking-tight text-offwhite">Apply for wholesale</h2>
      <p class="mt-4 text-sm font-medium text-offwhite/70">
        Secure form with server validation lives on the PHP endpoint.
      </p>
      <a
        href="/wholesale-apply.php"
        class="mt-10 inline-block border-2 border-imperial bg-imperial px-8 py-4 text-xs font-bold uppercase tracking-widest text-offwhite hover:bg-coal"
      >
        Apply for wholesale
      </a>
    </div>
  </section>
</BaseLayout>
