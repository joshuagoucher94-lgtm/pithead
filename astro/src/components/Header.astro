---
const links = [
  { href: '/shop/', label: 'Shop' },
  { href: '/cacao/', label: 'Cacao' },
  { href: '/drinks/', label: 'Drinks' },
  { href: '/wholesale/', label: 'Wholesale' },
  { href: '/about/', label: 'About' },
];
---

<header
  class="sticky top-0 z-50 border-b border-offwhite/20 bg-coal/95 backdrop-blur-sm"
  x-data="{ open: false }"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 md:px-8">
    <a href="/" class="text-lg font-bold tracking-tight text-offwhite md:text-xl">
      PITHEAD<span class="text-stone"> </span>ROASTWORKS
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-sm font-semibold uppercase tracking-tight text-offwhite/90 hover:text-imperial"
        >
          {l.label}
        </a>
      ))}
      <a
        href="/shop/cart.php"
        class="border border-offwhite/40 px-3 py-1 text-xs font-bold uppercase tracking-widest text-offwhite hover:border-imperial hover:text-imperial"
      >
        Cart
      </a>
    </nav>
    <button
      type="button"
      class="md:hidden border border-offwhite/40 px-3 py-2 text-xs font-bold uppercase tracking-widest text-offwhite"
      @click="open = !open"
      aria-expanded="false"
      :aria-expanded="open"
    >
      Menu
    </button>
  </div>
  <div
    class="border-t border-offwhite/10 bg-coal md:hidden"
    x-show="open"
    x-cloak
    x-transition
  >
    <nav class="flex flex-col gap-0 px-4 py-4" aria-label="Mobile">
      {links.map((l) => (
        <a
          href={l.href}
          class="border-b border-offwhite/10 py-3 text-sm font-semibold uppercase tracking-tight"
        >
          {l.label}
        </a>
      ))}
      <a href="/shop/cart.php" class="py-3 text-sm font-bold uppercase tracking-widest text-imperial">
        Cart
      </a>
    </nav>
  </div>
</header>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
